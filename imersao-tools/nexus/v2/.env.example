# Nexus v2 — Variáveis de ambiente
# Conforme architecture-v2.md §9.2 — todas server-only excepto NEXT_PUBLIC_*.
# Copia este ficheiro para `.env.local` e preenche os valores.
# Em produção, configura via Vercel Dashboard → Settings → Environment Variables.

# ─── Anthropic ─────────────────────────────────────────────────
# API key para Claude (Sonnet 4.6 + Haiku 4.5). NUNCA expor ao client.
ANTHROPIC_API_KEY=sk-ant-...

# ─── Auth ──────────────────────────────────────────────────────
# Hash bcrypt da password única (single-user, Eurico). Gera com:
#   node -e "console.log(require('bcryptjs').hashSync('a-tua-password', 10))"
NEXUS_PASSWORD_HASH=$2a$10$...

# Secret para assinar cookies de sessão. Gera com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ─── Google OAuth (Calendar + Gmail) ───────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://nexus-eurico.vercel.app/api/google/oauth/callback

# ─── Telegram Bot ──────────────────────────────────────────────
# Token do BotFather. CHAT_ID é o ID Telegram do Eurico.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# ─── Web Push (VAPID) ──────────────────────────────────────────
# Gera com: npx web-push generate-vapid-keys
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC=
WEB_PUSH_VAPID_PRIVATE=

# ─── Vercel KV (Upstash) ───────────────────────────────────────
# Para sessões, rate limiting, cache, refresh tokens.
KV_REST_API_URL=
KV_REST_API_TOKEN=
